generator client {
provider = "prisma-client-js"
}


datasource db {
provider = "postgresql"
url = env("DATABASE_URL")
}

model Product {
id Int @id @default(autoincrement())
sku String @unique
name String
description String?
priceCents Int
currency String @default("INR")
stock Int @default(0)
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
}